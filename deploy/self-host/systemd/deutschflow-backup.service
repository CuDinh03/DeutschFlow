[Unit]
Description=DeutschFlow — backup Postgres (age) lên /backup + R2
Wants=network-online.target docker.service
After=network-online.target docker.service
# Backup hỏng ⇒ báo Telegram TRỰC TIẾP (không cần Prometheus còn sống). Xem telegram-alert.sh.
OnFailure=deutschflow-alert@%n.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/srv/deutschflow/repo/deploy/self-host/backup-db.sh
Nice=10
IOSchedulingClass=idle
