# ============================================================
# Alertmanager config — DeutschFlow
#
# VM tự host (09/11/2026): KHÔNG sửa tay file này. deploy/self-host/install-monitoring.sh sinh
# /srv/deutschflow/env/alertmanager.yml từ đây, thay __TELEGRAM_CHAT_ID__ bằng TELEGRAM_CHAT_ID trong
# /srv/deutschflow/env/telegram.env. Token bot KHÔNG nằm trong config: Alertmanager đọc
# bot_token_file (mount từ /home/deploy/secrets/telegram_bot_token — xem monitoring.compose.yml).
# Owner tạo bot: nhắn @BotFather → /newbot; lấy chat id: nhắn bot một câu rồi mở
# https://api.telegram.org/bot<TOKEN>/getUpdates (hoặc @userinfobot). Chi tiết: docs/GIAM_SAT_TU_HOST.md
# ============================================================

global:
  resolve_timeout: 5m

route:
  receiver: 'telegram'
  group_by: ['alertname']
  group_wait: 30s        # gom các alert nổ gần nhau trong 30s thành 1 tin
  group_interval: 5m
  repeat_interval: 1h    # nếu vẫn đang lỗi, nhắc lại mỗi 1h
  routes:
    # Alert severity=critical (DbPoolExhausted, HighErrorRate) → nhắc lại dày hơn
    - matchers:
        - severity = "critical"
      repeat_interval: 15m

receivers:
  - name: 'telegram'
    telegram_configs:
      - bot_token_file: /etc/alertmanager-secrets/telegram_bot_token
        chat_id: __TELEGRAM_CHAT_ID__          # số nguyên, KHÔNG để trong nháy
        api_url: 'https://api.telegram.org'
        parse_mode: 'HTML'
        send_resolved: true
        message: |
          {{ range .Alerts }}<b>{{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} {{ .Labels.alertname }}</b> ({{ .Labels.severity }})
          {{ .Annotations.summary }}
          {{ .Annotations.description }}
          {{ end }}

# ── (Tuỳ chọn) Slack thay cho Telegram — bỏ comment + sửa receiver ở route ──
