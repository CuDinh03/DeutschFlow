# ============================================================
# DeutschFlow — Frontend Environment Variables
# Copy thành .env.local cho local dev, hoặc truyền build arg khi dựng image frontend cho production.
# KHÔNG commit file chứa secret thật lên git.
# ============================================================

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Local:      http://localhost:8080
# Production: https://api.mydeutschflow.com  (public HTTPS URL — browser gọi trực tiếp)
#
# ⚠️  QUAN TRỌNG: NEXT_PUBLIC_ được bake vào JS bundle lúc `next build`.
#     Phải dùng URL public HTTPS (không phải Docker-internal http://backend:8080).
#     Thiếu hoặc sai URL → mọi API call từ browser sẽ fail.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# ─── JWT Secret (BẮT BUỘC — PHẢI khớp với backend JWT_SECRET) ───────────────
# ⚠️  QUAN TRỌNG: Nếu thiếu biến này, middleware sẽ từ chối mọi token hợp lệ
#     và redirect người dùng về /login ngay sau khi đăng nhập thành công.
#
# Cách lấy giá trị:
#   - Local: copy từ .env (giá trị JWT_SECRET của backend)
#   - Production: truyền lúc build image frontend trên máy chủ tự host
JWT_SECRET=<same-value-as-backend-JWT_SECRET>

# ─── Kho media (Cloudflare R2) ────────────────────────────────────────────────
# Gốc presigned URL, phân tách bằng dấu phẩy — vào CSP + next/image (media-origins.mjs).
NEXT_PUBLIC_MEDIA_ORIGINS=https://<account_id>.r2.cloudflarestorage.com

# ─── PostHog Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_SHARED_DASHBOARD_URL=https://us.posthog.com/shared/xxxxxxxx

# ─── Sentry Crash Reporting (tùy chọn) ────────────────────────────────────────
# Để trống = tắt hoàn toàn (không gửi gì). Set DSN để bật crash reporting.
# Lấy DSN tại: Sentry → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=production
